# Large data / results (keep out of GitHub)
数据/
结果/
**/real_results/
**/result/
**/real_result/
**/results/

# Binary scientific data
*.npy
*.npz
*.segy
*.sgy
*.h5
*.hdf5
*.mat
*.bin

# Large checkpoints (GitHub soft limit 50MB / hard 100MB)
*.pth
*.pt
*.ckpt
*.onnx
*.pkl
*.pickle

# Python / IDE
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local helper scripts
_setup_check.ps1
_project_root.txt
_gh_setup.ps1
_gh_login.ps1
_make_sample_data.ps1
_make_sample.py
_check_data_sample.ps1
_commit_and_check_gh.ps1

# Allow tiny sample patches (must come after *.npy)
!sample_data/
!sample_data/**
!sample_data/*.npy
